# Скопируй в secrets.yaml (и HA, и ESPHome его подхватывают), заполни своими значениями.
# Никогда не коммить настоящий secrets.yaml в публичный git-репозиторий.

wifi_ssid: "..."
wifi_password: "..."
api_encryption_key: "..."      # esphome generate-encryption-key
ota_password: "..."

gemini_api_key: "..."          # Google AI Studio -> Get API key
telegram_bot_token: "..."      # от @BotFather
telegram_chat_id: "..."        # от @userinfobot

# google_client_id / google_client_secret сюда НЕ нужны - для интеграции
# Google Calendar в самом HA (шаг 12 TUTORIAL.md) client_id/secret вводятся
# прямо в диалоге добавления интеграции через UI, не через secrets.yaml.
