# Дополнение для сборки с BLE-маячком телефона (net/room, docs/room-presence.md). Сборка в отдельную папку:
#   .\idf.ps1 -B build-ble "-DSDKCONFIG=sdkconfig.ble.gen" "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.ble" build
# Только наблюдатель (пассивный скан iBeacon), без GATT и соединений. Стек поднимается лишь по
# сообщению ble_scan. Цена по замеру: +22 КБ внутренней RAM (IRAM) сразу, +138 КБ флеша.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=n
CONFIG_BT_NIMBLE_GAP_SERVICE=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=3072
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=0
