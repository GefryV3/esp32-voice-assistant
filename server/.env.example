# Скопировать в .env и заполнить. .env в git не попадает.

# Общий секрет колонки и сервера: тот же, что DEVICE_TOKEN в firmware/main/secrets.h.
# Сгенерировать: py -c "import secrets; print(secrets.token_urlsafe(24))"
JARVIS_DEVICE_TOKEN=

# Где слушать колонки.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Часовой пояс для часов на экране (строка POSIX TZ). По умолчанию — Вена.
JARVIS_TZ=CET-1CEST,M3.5.0,M10.5.0/3

JARVIS_LOG_LEVEL=INFO

# Голос: ключ Gemini API (aistudio.google.com → Get API key). Без него колонка не разговаривает.
GEMINI_API_KEY=
# Модель Gemini Live и встроенный голос (мужские: Charon, Orus, Fenrir, Puck, Iapetus…).
JARVIS_GEMINI_MODEL=gemini-3.8-live
JARVIS_VOICE=Charon
# Эмоциональный диалог Gemini (слышит интонацию, отвечает в тон): 1 — включить, если модель умеет.
# JARVIS_AFFECTIVE=0   # Gemini 3.8 Live убрал эмоциональный диалог (ошибка 1007), по умолчанию выкл
# JARVIS_GEMINI_FALLBACK_MODEL=gemini-live-2.5-flash-preview   # голос при 503
# JARVIS_FALLBACK_TEXT_MODEL=gemini-flash-latest   # агенты и Telegram при 503
# Слова пробуждения через запятую: мага (своё русское, Vosk) и jarvis (Hey Jarvis, openWakeWord).
JARVIS_WAKE_WORDS=мага,jarvis
# Порог слова пробуждения 0…1: выше — реже ложные срабатывания, но надо говорить чётче.
JARVIS_WAKE_THRESHOLD=0.5

# Умный дом (необязательно). В аддоне HA сам даёт доступ; при разработке — адрес и
# долгоживущий токен (профиль HA → Безопасность).
# JARVIS_HA_URL=ws://192.168.178.86:8123/api/websocket
# JARVIS_HA_TOKEN=

# Telegram-бот (необязательно; нужен и GEMINI_API_KEY). Токен — от @BotFather, chat_id —
# твой числовой id (узнать: написать боту @userinfobot), несколько — через запятую.
# Чужим чатам бот не отвечает. Напоминания уходят сюда, если колонка не смогла сказать.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
# Текстовая модель Gemini для ответов в Telegram (не Live).
# JARVIS_TELEGRAM_MODEL=gemini-flash-latest

# Модель фоновых агентов (долгие задачи с поиском в интернете).
# JARVIS_AGENT_MODEL=gemini-flash-lite-latest
# Источник поиска для фоновых задач: brave (ключ BRAVE_API_KEY с api.search.brave.com, бесплатно
# ~2000 запросов в месяц), searxng (JARVIS_SEARXNG_URL=http://адрес:порт), web (DuckDuckGo, часто
# просит капчу) или google (поиск Gemini, на бесплатном ключе ~20 запросов в сутки).
# Без карты: tavily (TAVILY_API_KEY, app.tavily.com, ~1000/мес) и serper (SERPER_API_KEY, serper.dev, 2500 при регистрации).
# JARVIS_AGENT_SEARCH=tavily
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Перебивание голосом: 0 выключает; порог — во сколько раз голос громче эха ответа.
# JARVIS_BARGE_IN=1
# JARVIS_BARGE_RATIO=3.0

# Google (календарь, почта, задачи) напрямую, без HA. Инструкция: docs/google.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN запишет tools/google_auth.py

# Присутствие: пока пользователя «нет на месте», колонка не отзывается на слово и ask
# (напоминания, будильник и фоновые задачи работают). auto — решает сама, off — всегда отзывается.
# Ручное переопределение: консоль/Telegram `presence auto|here|away`. Пороги — минуты.
# JARVIS_PRESENCE=auto
# JARVIS_PRESENCE_PC_MIN=10
# JARVIS_PRESENCE_PHONE_MIN=10
# JARVIS_PRESENCE_IDLE_MIN=180

# Куда стучатся pc/agent.py и tools/send.py: сервер-аддон на ноутбуке с HA.
# Для сервера, запущенного здесь же, — 127.0.0.1.
JARVIS_SERVER=192.168.178.86

# Рутины: колонка сама заговаривает (нужен GEMINI_API_KEY). on|off.
# Утренний брифинг: когда на телефоне выключили будильник, а если его не выключали — в это время.
# Приветствие при возвращении домой работает при подключённом Home Assistant (person.*).
# JARVIS_ROUTINES=on
# JARVIS_BRIEFING_AT=08:00

# ── Утренний пакет (docs/changes/morning-pack.md) ──
# Расписание WebUntis: либо ссылка «Календарь-Abo» (iCal), либо логин ученика. Без этого будильника по расписанию нет.
# UNTIS_ICAL_URL=
# UNTIS_SERVER=mese.webuntis.com
# UNTIS_SCHOOL=
# UNTIS_USER=
# UNTIS_PASSWORD=
# Будильник: сборы, автобус, к какому уроку он едет, когда вечером предлагать, input_datetime в HA (необязательно).
# WAKE_ALARM=on
# WAKE_PREP_MIN=60
# WAKE_BUS_DEPART=07:19
# WAKE_SCHOOL_START=08:00
# WAKE_EARLIEST=05:00
# WAKE_ASK_AT=21:30
# WAKE_ASK_UNTIL=23:00
# WAKE_HA_ENTITY=input_datetime.jarvis_wake
# Мягкое пробуждение через столько секунд после выключения будильника (вместо обычного брифинга).
# SOFT_WAKE=on
# SOFT_WAKE_DELAY_S=30
# Автобус (ÖBB HAFAS, без ключа): остановка по названию или extId, номер линии.
# TRANSIT_STOP=
# TRANSIT_LINE=
# BUS_WARN=on
# BUS_WATCH_MIN=40
# «Возьми зонт» при уходе из дома (Open-Meteo, без ключа).
# UMBRELLA=on
# WEATHER_LAT=48.208
# WEATHER_LON=16.373
# UMBRELLA_PROB=50
# UMBRELLA_HOURS=8
# Привычки: колонка иногда сама спрашивает «тренировка сегодня была?» по задачам Google.
# JARVIS_HABITS=on
# JARVIS_HABITS_PROB=0.5                  # вероятность, что сегодня вообще спросит (0…1)
# JARVIS_HABITS_WINDOWS=18:00-21:30       # окна для вопроса, через запятую
# JARVIS_HABITS_KEYWORDS=тренировк,бассейн,хомяк,немецк   # такие задачи спрашиваются в первую очередь

# Недельная сводка и резерв brain.db в Telegram (воскресенье вечером).
# JARVIS_DIGEST=on
# JARVIS_DIGEST_AT=19:00
