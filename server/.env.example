# Скопировать в .env и заполнить. .env в git не попадает.

# Общий секрет колонки и сервера: тот же, что DEVICE_TOKEN в firmware/main/secrets.h.
# Сгенерировать: py -c "import secrets; print(secrets.token_urlsafe(24))"
JARVIS_DEVICE_TOKEN=

# Где слушать колонки.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Часовой пояс для часов на экране (строка POSIX TZ). По умолчанию — Вена.
JARVIS_TZ=CET-1CEST,M3.5.0,M10.5.0/3

JARVIS_LOG_LEVEL=INFO

# Куда стучатся pc/agent.py и tools/send.py: сервер-аддон на ноутбуке с HA.
# Для сервера, запущенного здесь же, — 127.0.0.1.
JARVIS_SERVER=192.168.178.86
